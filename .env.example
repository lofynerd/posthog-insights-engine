NODE_ENV=development
LOG_LEVEL=info

POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

# AI Configuration (OpenAI-compatible endpoint)
# Using Gemini's OpenAI-compatible endpoint
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

SLACK_BOT_TOKEN=

# Bot token from @BotFather. Used by both the legacy single-chat
# pipeline (src/pipeline.js) and the multi-group interactive bot
# (src/bot.js).
TELEGRAM_BOT_TOKEN=
# Legacy single-chat mode only. Not required for the multi-group bot
# (src/bot.js), which uses the S3-backed group registry instead —
# groups self-register via the /register command in Telegram.
TELEGRAM_CHAT_ID=

# AWS S3 — used for report "memory" (cached PostHog snapshots so
# repeated reports on the same day don't re-query PostHog) and the
# group registry (chat ID -> group name + report type mapping).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
# All objects this app writes live under this prefix, so a shared
# bucket (e.g. one also used for unrelated site assets) never gets
# polluted or accidentally overwritten.
AWS_S3_KEY_PREFIX=posthog-insights-engine

# Brand name used to scope the AI relevance guard (src/ai/relevanceGuard.js)
# — the bot's /ask command only answers questions about this brand's
# analytics, rejecting off-topic requests to protect AI credits.
BRAND_NAME=Tomasi
