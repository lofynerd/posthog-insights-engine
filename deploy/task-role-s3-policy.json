{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowSnapshotAndRegistryObjectAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::tomasi-vercel-images/posthog-insights-engine/*"
        },
        {
            "Sid": "AllowListingOwnPrefixOnly",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::tomasi-vercel-images",
            "Condition": {
                "StringLike": {
                    "s3:prefix": "posthog-insights-engine/*"
                }
            }
        }
    ]
}
